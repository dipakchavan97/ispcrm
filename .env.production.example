# ==============================================================================
# ISPCRM PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Never commit real production secrets, passwords, or encryption keys to git.
# 2. Generate cryptographically strong random values for all passwords and keys.
#    - Generate 32-byte hex key: openssl rand -hex 32
#    - Generate 64-char base64:  openssl rand -base64 48
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
WORKER_PORT=4001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=ispcrm_admin
# Generate strong password: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD
POSTGRES_DB=ispcrm
DATABASE_PORT=5432

# Production connection string (used by API and Worker)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&sslmode=prefer

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (BullMQ & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Generate strong password: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 4. SECURITY & ENCRYPTION KEYS (CRITICAL)
# ------------------------------------------------------------------------------
# JWT Authentication Signing Key (minimum 32 characters, high-entropy)
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=7d

# Router Credential AES-256-GCM Encryption Key (must be exactly 32 bytes / 64 hex chars)
# Generate: openssl rand -hex 32
ROUTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example: https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 5. SSTP VPN CONCENTRATOR & ROUTING CONFIGURATION
# ------------------------------------------------------------------------------
# Publicly resolvable FQDN pointing to the VPS public IP
SSTP_SERVER_HOST=vpn.yourdomain.com
SSTP_SERVER_PORT=443

# Internal Docker / VPS Gateway IP address for the SSTP container
SSTP_SERVICE_HOST=sstp
SSTP_VPN_GATEWAY_IP=10.200.0.1
SSTP_VPN_SUBNET=10.200.0.0/16

# Shared volume paths inside containers
SSTP_CHAP_SECRETS_PATH=/etc/ppp/chap-secrets
SSTP_CA_CERT_PATH=/etc/ssl/sstp/ca.crt

# Production Let's Encrypt TLS Certificate Mount Paths (on VPS host)
# Host path: /etc/letsencrypt/live/vpn.yourdomain.com/fullchain.pem
# Host path: /etc/letsencrypt/live/vpn.yourdomain.com/privkey.pem
LETSENCRYPT_CERT_DIR=/etc/letsencrypt/live/vpn.yourdomain.com

# ------------------------------------------------------------------------------
# 6. FREERADIUS AAA ENGINE
# ------------------------------------------------------------------------------
# Global shared secret between FreeRADIUS and BNG / MikroTik NAS
# Generate: openssl rand -hex 16
RADIUS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799

# ------------------------------------------------------------------------------
# 7. VERCEL FRONTEND VARIABLE (Configure in Vercel Dashboard)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_APP_NAME=ISPCRM Portal
